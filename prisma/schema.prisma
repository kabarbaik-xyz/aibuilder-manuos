  itemId         String              @map("item_id")
  orderedAtoms   BigInt              @map("ordered_atoms")
  receivedAtoms  BigInt              @default(0) @map("received_atoms")
  unitPriceCents Int?                @map("unit_price_cents")
  notes          String?
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplyOrder    SupplyOrder         @relation(fields: [workspaceId, supplyOrderId], references: [workspaceId, id], onDelete: Cascade)
  item           Item                @relation(fields: [workspaceId, itemId], references: [workspaceId, id])
  receiptLines   SupplyReceiptLine[]

  @@unique([workspaceId, id])
  @@map("supply_order_lines")
}

model SupplyReceipt {
  id            String              @id @default(uuid())
  workspaceId   String              @map("workspace_id")
  receiptNumber String              @map("receipt_number")
  supplyOrderId String              @map("supply_order_id")
  supplierId    String              @map("supplier_id")
  receivedDate  DateTime            @default(now()) @map("received_date")
  notes         String?
  receivedById  String              @map("received_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplyOrder   SupplyOrder         @relation(fields: [workspaceId, supplyOrderId], references: [workspaceId, id])
  supplier      Supplier            @relation(fields: [workspaceId, supplierId], references: [workspaceId, id])
  receivedBy    User                @relation(fields: [receivedById], references: [id])
  lines         SupplyReceiptLine[]

  @@unique([workspaceId, receiptNumber])
  @@unique([workspaceId, id])
  @@map("supply_receipts")
}

model SupplyReceiptLine {
  id                String          @id @default(uuid())
  workspaceId       String          @map("workspace_id")
  receiptId         String          @map("receipt_id")
  supplyOrderLineId String          @map("supply_order_line_id")
  itemId            String          @map("item_id")
  locationId        String          @map("location_id")
  lotId             String?         @map("lot_id")
  receivedAtoms     BigInt          @map("received_atoms")
  movementId        String?         @map("movement_id")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receipt           SupplyReceipt   @relation(fields: [workspaceId, receiptId], references: [workspaceId, id], onDelete: Cascade)
  supplyOrderLine   SupplyOrderLine @relation(fields: [workspaceId, supplyOrderLineId], references: [workspaceId, id])
  item              Item            @relation(fields: [workspaceId, itemId], references: [workspaceId, id])
  location          Location        @relation(fields: [workspaceId, locationId], references: [workspaceId, id])
  lot               Lot?            @relation(fields: [workspaceId, lotId], references: [workspaceId, id])

  @@unique([workspaceId, id])
  @@map("supply_receipt_lines")
}

