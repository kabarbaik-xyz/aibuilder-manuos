  @@unique([workspaceId, id])
  @@unique([workspaceId, revisionNumber])
  @@index([workspaceId, periodStart, periodEnd])
  @@map("published_schedules")
}

model ApiKey {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  name         String
  keyPrefix    String    @map("key_prefix")
  keyHash      String    @map("key_hash")
  scopesJson   String    @default("[]") @map("scopes_json")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, keyPrefix])
  @@map("api_keys")
}

model WebhookEndpoint {
  id           String            @id @default(uuid())
  workspaceId  String            @map("workspace_id")
  url          String
  secret       String
  eventsJson   String            @default("[]") @map("events_json")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@unique([workspaceId, id])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String          @id @default(uuid())
  workspaceId  String          @map("workspace_id")
  endpointId   String          @map("endpoint_id")
  eventType    String          @map("event_type")
  payloadJson  String          @map("payload_json")
  statusCode   Int?            @map("status_code")
  attempts     Int             @default(1)
  status       String          @default("DELIVERED") // PENDING | DELIVERED | FAILED
  errorReason  String?         @map("error_reason")
  deliveredAt  DateTime?       @map("delivered_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [workspaceId, endpointId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, endpointId])
  @@map("webhook_deliveries")
}

model OfflineSyncQueue {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  userId         String    @map("user_id")
  commandType    String    @map("command_type")
  idempotencyKey String    @map("idempotency_key")
  payloadJson    String    @map("payload_json")
  status         String    @default("QUEUED") // QUEUED | APPLIED | CONFLICT | FAILED
  errorReason    String?   @map("error_reason")
  appliedAt      DateTime? @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, userId, status])
  @@map("offline_sync_queues")
}

model JobCostEntry {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  orderId      String    @map("order_id")
  taskId       String?   @map("task_id")
  costCategory String    @map("cost_category") // MATERIAL | LABOR | MACHINE | OUTSOURCED | SCRAP
  costType     String    @map("cost_type")     // STANDARD | ACTUAL
  amountCents  BigInt    @map("amount_cents")
  currency     String    @default("IDR")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order        Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, orderId, costType])
  @@map("job_cost_entries")
}

model CommunicationConsent {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  recipient    String
  channel      String    // EMAIL | WHATSAPP
  isOptedIn    Boolean   @default(true) @map("is_opted_in")
  optedInAt    DateTime  @default(now()) @map("opted_in_at")
  optedOutAt   DateTime? @map("opted_out_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, recipient, channel])
  @@map("communication_consents")
}
