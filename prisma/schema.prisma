  resourceType String    @map("resource_type") // TECHNICIAN | MACHINE
  resourceId   String    @map("resource_id")
  taskId       String    @map("task_id")
  startAt      DateTime  @map("start_at")
  endAt        DateTime  @map("end_at")
  status       String    @default("CONFIRMED") // CONFIRMED | CANCELLED
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task         Task      @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, resourceType, resourceId])
  @@map("resource_bookings")
}

model WorkSession {
  id              String     @id @default(uuid())
  workspaceId     String     @map("workspace_id")
  taskId          String     @map("task_id")
  technicianId    String     @map("technician_id")
  sessionType     String     @map("session_type") // RUNNING | PAUSED
  startedAt       DateTime   @map("started_at")
  endedAt         DateTime?  @map("ended_at")
  durationMinutes Int?       @map("duration_minutes")
  notes           String?
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task            Task       @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  technician      Technician @relation(fields: [workspaceId, technicianId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, taskId])
  @@map("work_sessions")
}

// -------------------------------------------------------------
// Production Output & Quality Management (Milestone M3 - O06)
// -------------------------------------------------------------

model ProductionOutput {
  id                    String       @id @default(uuid())
  workspaceId           String       @map("workspace_id")
  taskId                String       @map("task_id")
  attemptNumber         Int          @default(1) @map("attempt_number")
  itemId                String       @map("item_id")
  lotId                 String?      @map("lot_id")
  serialId              String?      @map("serial_id")
  outputAtoms           BigInt       @map("output_atoms")
  destinationLocationId String       @map("destination_location_id")
  movementId            String?      @map("movement_id")
  isFinal               Boolean      @default(false) @map("is_final")
  status                String       @default("RECORDED") // RECORDED | INSPECTED | REJECTED
  operatorUserId        String       @map("operator_user_id")
  commandId             String?      @map("command_id")
  notes                 String?
  version               Int          @default(1)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  workspace             Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task                  Task         @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  item                  Item         @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade)
  lot                   Lot?         @relation(fields: [workspaceId, lotId], references: [workspaceId, id])
  destinationLocation   Location     @relation(fields: [workspaceId, destinationLocationId], references: [workspaceId, id])
  operatorUser          User         @relation(fields: [operatorUserId], references: [id])
  inspections           Inspection[]

  @@unique([workspaceId, id])
  @@index([workspaceId, taskId])
  @@index([workspaceId, itemId])
  @@map("production_outputs")
}

model Inspection {
  id                 String             @id @default(uuid())
  workspaceId        String             @map("workspace_id")
  sourceType         String             @map("source_type") // PRODUCTION_OUTPUT | GOODS_RECEIPT
  productionOutputId String?            @map("production_output_id")
  supplyReceiptId    String?            @map("supply_receipt_id")
  qcChecklistId      String?            @map("qc_checklist_id")
  checklistRevision  Int                @default(1) @map("checklist_revision")
  inspectedAtoms     BigInt             @map("inspected_atoms")
  passedAtoms        BigInt             @default(0) @map("passed_atoms")
  reworkAtoms        BigInt             @default(0) @map("rework_atoms")
  scrappedAtoms      BigInt             @default(0) @map("scrapped_atoms")
  status             String             @default("DRAFT") // DRAFT | FINALIZED
  disposition        String?            // PASSED | REWORK | SCRAPPED | PARTIAL
  inspectorUserId    String             @map("inspector_user_id")
  reinspectionOfId   String?            @map("reinspection_of_id")
  notes              String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionOutput   ProductionOutput?  @relation(fields: [workspaceId, productionOutputId], references: [workspaceId, id], onDelete: Cascade)
  qcChecklist        QcChecklist?       @relation(fields: [workspaceId, qcChecklistId], references: [workspaceId, id])
  inspectorUser      User               @relation(fields: [inspectorUserId], references: [id])
  reinspectionOf     Inspection?        @relation("Reinspections", fields: [workspaceId, reinspectionOfId], references: [workspaceId, id])
  reinspections      Inspection[]       @relation("Reinspections")
  results            InspectionResult[]
  reworkAttempts     ReworkAttempt[]

  @@unique([workspaceId, id])
  @@index([workspaceId, productionOutputId])
  @@map("inspections")
}

model InspectionResult {
  id               String     @id @default(uuid())
  workspaceId      String     @map("workspace_id")
  inspectionId     String     @map("inspection_id")
  checkCode        String     @map("check_code")
  checkDescription String     @map("check_description")
  checkMethod      String     @map("check_method")
  measuredValue    String?    @map("measured_value")
  isPassed         Boolean    @map("is_passed")
  defectReason     String?    @map("defect_reason")
  notes            String?
  evidenceDocumentId String?    @map("evidence_document_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inspection       Inspection @relation(fields: [workspaceId, inspectionId], references: [workspaceId, id], onDelete: Cascade)
  evidenceDocument Document? @relation("QcEvidenceDocument", fields: [workspaceId, evidenceDocumentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, inspectionId])
  @@map("inspection_results")
}

model ReworkAttempt {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  inspectionId   String     @map("inspection_id")
  taskId         String     @map("task_id")
  attemptNumber  Int        @map("attempt_number")
  targetAtoms    BigInt     @map("target_atoms")
  instruction    String
  status         String     @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  authorizedById String     @map("authorized_by_id")
  authorizedAt   DateTime   @default(now()) @map("authorized_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inspection     Inspection @relation(fields: [workspaceId, inspectionId], references: [workspaceId, id], onDelete: Cascade)
  task           Task       @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  authorizedBy   User       @relation(fields: [authorizedById], references: [id])

  @@unique([workspaceId, id])
  @@index([workspaceId, taskId])
  @@map("rework_attempts")
}

// -------------------------------------------------------------
// Delivery & Shipment Management (Milestone M3 - O07)
// -------------------------------------------------------------

model Shipment {
  id                 String         @id @default(uuid())
  workspaceId        String         @map("workspace_id")
  shipmentNumber     String         @map("shipment_number")
  orderId            String         @map("order_id")
  customerId         String         @map("customer_id")
  status             String         @default("ALLOCATED") // ALLOCATED | DISPATCHED | DELIVERED | CANCELLED
  allocatedAt        DateTime       @default(now()) @map("allocated_at")
  dispatchedAt       DateTime?      @map("dispatched_at")
  deliveredAt        DateTime?      @map("delivered_at")
  carrierName        String?        @map("carrier_name")
  trackingNumber     String?        @map("tracking_number")
  destinationAddress String?        @map("destination_address")
  proofOfDelivery    String?        @map("proof_of_delivery")
  receivedBy         String?        @map("received_by")
  notes              String?
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order              Order          @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  customer           Customer       @relation(fields: [workspaceId, customerId], references: [workspaceId, id])
  lines              ShipmentLine[]

  @@unique([workspaceId, shipmentNumber])
  @@unique([workspaceId, id])
  @@index([workspaceId, orderId])
  @@index([workspaceId, customerId])
  @@map("shipments")
}

model ShipmentLine {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  shipmentId       String    @map("shipment_id")
  orderLineId      String?   @map("order_line_id")
  itemId           String    @map("item_id")
  lotId            String?   @map("lot_id")
  sourceLocationId String    @map("source_location_id")
  allocatedAtoms   BigInt    @map("allocated_atoms")
  dispatchedAtoms  BigInt    @default(0) @map("dispatched_atoms")
  deliveredAtoms   BigInt    @default(0) @map("delivered_atoms")
  movementId       String?   @map("movement_id")
  reservationId    String?   @map("reservation_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shipment         Shipment  @relation(fields: [workspaceId, shipmentId], references: [workspaceId, id], onDelete: Cascade)
  orderLine        OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  item             Item      @relation(fields: [workspaceId, itemId], references: [workspaceId, id])
  lot              Lot?      @relation(fields: [workspaceId, lotId], references: [workspaceId, id])
  sourceLocation   Location  @relation(fields: [workspaceId, sourceLocationId], references: [workspaceId, id])

  @@unique([workspaceId, id])
  @@index([workspaceId, shipmentId])
  @@index([orderLineId])
  @@map("shipment_lines")
}

model RecoveryProposal {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  orderId         String   @map("order_id")
  orderVersion    Int      @map("order_version")
  proposalJson    String   @map("proposal_json")
  status          String   @default("PROPOSED") // PROPOSED | APPROVED | SUPERSEDED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, orderId, status])
  @@map("recovery_proposals")
}

// -------------------------------------------------------------
// Document Management & Customer Evidence (Milestone M3 - O08)
// -------------------------------------------------------------

model Document {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  storageKey     String         @unique @map("storage_key")
  fileName       String         @map("file_name")
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes")
  checksumSha256 String         @map("checksum_sha256")
  uploadedById   String         @map("uploaded_by_id")
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  links          DocumentLink[]
  drawingRevisions DrawingRevision[]
  formSubmissionDocuments FormSubmissionDocument[]
  qcEvidenceResults InspectionResult[] @relation("QcEvidenceDocument")

  @@unique([workspaceId, id])
  @@index([workspaceId, storageKey])
  @@map("documents")
}

model DocumentLink {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  documentId      String    @map("document_id")
  parentType      String    @map("parent_type") // ORDER | TASK | INSPECTION | SHIPMENT | PASSPORT
  parentId        String    @map("parent_id")
  customerVisible Boolean   @default(false) @map("customer_visible")
  createdAt       DateTime  @default(now()) @map("created_at")

