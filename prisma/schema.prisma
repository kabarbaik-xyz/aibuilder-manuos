  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item          Item      @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade)
  location      Location  @relation(fields: [workspaceId, locationId], references: [workspaceId, id], onDelete: Cascade)
  lot           Lot?      @relation(fields: [workspaceId, lotId], references: [workspaceId, id])

  @@unique([workspaceId, bucketKey])
  @@unique([workspaceId, id])
  @@map("stock_balances")
}

model StockReservation {
  id            String          @id @default(uuid())
  workspaceId   String          @map("workspace_id")
  demandId      String?         @map("demand_id")
  orderId       String?         @map("order_id")
  taskId        String?         @map("task_id")
  itemId        String          @map("item_id")
  locationId    String          @map("location_id")
  lotId         String?         @map("lot_id")
  reservedAtoms BigInt          @map("reserved_atoms")
  status        String          @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  demand        MaterialDemand? @relation(fields: [workspaceId, demandId], references: [workspaceId, id])
  order         Order?          @relation(fields: [workspaceId, orderId], references: [workspaceId, id])
  task          Task?           @relation(fields: [workspaceId, taskId], references: [workspaceId, id])
  item          Item            @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade)
  location      Location        @relation(fields: [workspaceId, locationId], references: [workspaceId, id], onDelete: Cascade)
  lot           Lot?            @relation(fields: [workspaceId, lotId], references: [workspaceId, id])

  @@unique([workspaceId, id])
  @@map("stock_reservations")
}

model StockMovement {
  id                    String    @id @default(uuid())
  workspaceId           String    @map("workspace_id")
  movementType          String    @map("movement_type") // OPENING_BALANCE | PURCHASE_RECEIPT | TRANSFER | ISSUE_TO_WIP | RETURN_FROM_WIP | PRODUCTION_CONSUME | PRODUCTION_OUTPUT | QC_DISPOSITION | SHIPMENT | ADJUSTMENT
  itemId                String    @map("item_id")
  sourceLocationId      String?   @map("source_location_id")
  destinationLocationId String?   @map("destination_location_id")
  sourceLotId           String?   @map("source_lot_id")
  destinationLotId      String?   @map("destination_lot_id")
  atoms                 BigInt
  referenceType         String?   @map("reference_type") // OPENING | SUPPLY_ORDER | ORDER | TASK | QC_INSPECTION | SHIPMENT | COUNT | MANUAL
  referenceId           String?   @map("reference_id")
  actorUserId           String    @map("actor_user_id")
  commandId             String?   @map("command_id")
  notes                 String?
  occurredAt            DateTime  @default(now()) @map("occurred_at")

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item                  Item      @relation(fields: [workspaceId, itemId], references: [workspaceId, id], onDelete: Cascade)
  sourceLocation        Location? @relation("SourceLocation", fields: [workspaceId, sourceLocationId], references: [workspaceId, id])
  destinationLocation   Location? @relation("DestLocation", fields: [workspaceId, destinationLocationId], references: [workspaceId, id])
  sourceLot             Lot?      @relation("SourceLot", fields: [workspaceId, sourceLotId], references: [workspaceId, id])
  destinationLot        Lot?      @relation("DestLot", fields: [workspaceId, destinationLotId], references: [workspaceId, id])
  actorUser             User      @relation(fields: [actorUserId], references: [id])

  @@index([workspaceId, itemId])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, referenceType, referenceId])
  @@unique([workspaceId, id])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// Supply Orders & Receipts (Milestone M3 - O02)
// -------------------------------------------------------------

model SupplyOrder {
  id             String            @id @default(uuid())
  workspaceId    String            @map("workspace_id")
  orderNumber    String            @map("order_number")
  supplierId     String            @map("supplier_id")
  status         String            @default("DRAFT") // DRAFT | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  expectedDate   DateTime          @map("expected_date")
  notes          String?
  version        Int               @default(1)
  approvedById   String?           @map("approved_by_id")
  approvedAt     DateTime?         @map("approved_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier       Supplier          @relation(fields: [workspaceId, supplierId], references: [workspaceId, id])
  lines          SupplyOrderLine[]
  receipts       SupplyReceipt[]

  @@unique([workspaceId, orderNumber])
  @@unique([workspaceId, id])
