# Google Gemini API key for server-side AI routes (/api/ai/*)
# Keep server-only. Do NOT prefix with NEXT_PUBLIC_!
# In Cloud Run, bind this from Secret Manager.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults to gemini-2.5-flash / gemini-2.5-pro)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
